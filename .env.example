# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# 网络搜索容错配置（可省略，使用默认值）
# 单次请求超时秒数；链路较慢或开启 include_raw_content 时可适当调大
TAVILY_TIMEOUT=30
# 传输层重试次数：处理连接池里已被对端关闭的 keep-alive 连接（间歇性 ConnectionReset 的主因）
TAVILY_TRANSPORT_RETRIES=3
# 应用层尝试次数：传输层重试耗尽后整体再试的次数
TAVILY_MAX_ATTEMPTS=2
# 退避基数：第 n 次重试等待 TAVILY_BACKOFF_BASE * 2^(n-1) 秒
TAVILY_BACKOFF_BASE=0.8
# 所在网络需要代理访问 Tavily 时才需要设置（不设则跟随系统 HTTP_PROXY / HTTPS_PROXY）
# TAVILY_HTTP_PROXY=http://127.0.0.1:7890
# TAVILY_HTTPS_PROXY=http://127.0.0.1:7890

# 自建 RAG embedding 配置（可选）
# 三项齐全时启用向量语义检索（与 BM25 双路融合）；任一缺失时自动降级为纯 BM25，系统仍可用
#
# 推荐：本地 TEI 服务（HuggingFace text-embeddings-inference + bge-large-zh-v1.5，1024 维）
#   docker compose --env-file .env -f docker/docker-compose.yaml up -d embedding
#   （模型文件需放在 docker/embedding/bge-large-zh-v1.5/）
# 备选：任意 OpenAI 兼容 /embeddings 端点（硅基流动、DashScope 等），改下面三行即可
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=local-tei
EMBEDDING_MODEL=bge-large-zh-v1.5
# embedding 服务对外端口，需与上面 BASE_URL 的端口一致
EMBEDDING_PORT=8081

# 向量库 Qdrant（可选，见 ADR-007）
# 存放 chunk 向量，与关键词路组成双路检索；服务未启动时自动降级为纯 BM25
#   docker compose --env-file .env -f docker/docker-compose.yaml up -d qdrant
# dashboard: http://localhost:6333/dashboard
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=deepsearch_kb
# 对外端口，需与上面 QDRANT_URL 的端口一致
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 关键词检索 Elasticsearch（可选，见 ADR-008）
# 自建镜像已装 IK 中文分词插件（ik_max_word 索引 / ik_smart 查询），
# 承接双路检索里的「关键词路」；未启动时检索层自动回退进程内 rank_bm25
#   docker compose --env-file .env -f docker/docker-compose.yaml up -d --build elasticsearch
# 可选可视化（镜像约 2.1GB，按需启动）：
#   docker compose --env-file .env -f docker/docker-compose.yaml --profile kibana up -d kibana
ES_URL=http://localhost:9201
ES_INDEX=deepsearch_kb
# 对外端口，需与上面 ES_URL 的端口一致（默认 9201 避开本机可能已有的 9200）
ES_PORT=9201
# Kibana 端口（仅 --profile kibana 时生效）
KIBANA_PORT=5602
# 置 0 可强制走进程内 rank_bm25（离线演示或评测对照用）
ES_ENABLED=1
# 若 ES 开启了 xpack 安全，填账号密码（本地默认关闭，留空即可）
# ES_USERNAME=elastic
# ES_PASSWORD=你的_ES_密码

# 精排 reranker（生产检索链路，见 ADR-012）
# cross-encoder（bge-reranker-v2-m3）把 RRF 融合后的候选池逐对重排，
# 离线实测 Recall@5 59.3% → 84.3%（吃满候选池上限的 99%）。
#
# 推理走**进程内 ONNX**（onnxruntime + tokenizers），不走 HTTP、不走容器：
# 这一步同时消掉了 TEI 的两个遗留问题——queue_time 排队与 candle 后端的 SIGSEGV 崩溃。
# 模型：docker/reranker/bge-reranker-v2-m3/（约 2.2GB，不入 git），
#       其中 onnx/model.onnx + model.onnx_data 由 optimum-cli 从 model.safetensors 导出。
#
# 三态开关：
#   auto（默认）= 仅当 CUDA 执行提供器**真正生效**时启用（避免在纯 CPU 机器上
#                把每次检索从 0.2s 拖到秒级）
#   1          = 强制启用（允许 CPU 执行提供器，慢但可用；无 GPU 环境/对照实验用）
#   0          = 关闭，检索引擎回到纯 hybrid（RRF 融合）
# 精排不可用时检索自动退化为 hybrid，不会失败。
# ⚠ Windows + GPU 需要 onnxruntime-gpu==1.22.0（CUDA 12 世代）+ nvidia-*-cu12；
#   最新的 1.31 要 CUDA 13，而 cublas 的 cu13 包在 PyPI 上没有 Windows wheel。
RERANK_ENABLED=auto
# 执行提供器偏好：auto（CUDA 优先、CPU 兜底）| cuda | cpu
RERANK_PROVIDER=auto
# 单次前向的候选批大小（GPU 上批越大越省 kernel launch）
RERANK_BATCH_SIZE=16
# 精排用的每路候选深度（0 = 沿用 top_k×3 = 15，池≈21 条）。
# 生产取 25（池≈34）：15→25 用 +0.16s 换 +2.7pt Recall@5，是性价比拐点；
# 再往上（40/60/100）精排耗时近似线性增长（单候选 ≈14ms 恒定），质量只多 1~2pt。
# 深池曲线与结论见 app/eval/results/2026-10-10__rerank-deep-pool.md（ADR-013）
RERANK_CANDIDATE_K=25

# 【历史】TEI 容器形态的精排（已不用于生产，保留作对照实验与 CPU 回退参考）
#   docker compose --env-file .env -f docker/docker-compose.yaml --profile rerank up -d reranker
# ⚠️ 纯 CPU 上慢（约 400ms/候选）且不稳（candle 后端约每 10 请求 SIGSEGV），
#    崩溃还会连带 WSL2 VM 崩并在 %LOCALAPPDATA%\Temp\wsl-crashes\ 写约 3GB 转储
RERANKER_URL=http://localhost:8082/rerank
# 对外端口，需与上面 RERANKER_URL 的端口一致
RERANKER_PORT=8082

# 知识库摄入命令：python -m app.rag.ingest（加 --force 全量重建索引）
# 注意：bge-large-zh-v1.5 单条输入上限 512 token（约 512 个中文字），
#       切分参数 CHUNK_SIZE 已控制在 400 字符以内，不要随意调大
# 摄入性能相关（可选）：CPU 推理下批越小单请求越快；超时给足窗口避免大批量摄入中途失败
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_TIMEOUT=120

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# 反思循环配置（可省略，使用默认值）
# 最大迭代轮数：每轮 = 执行 → 反思评估 → 补充检索
REFLECTION_MAX_ROUNDS=3
# token 预算上限：累计消耗超过该值后停止迭代，输出当前最优结果
REFLECTION_TOKEN_BUDGET=150000
