# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# 网络搜索容错配置（可省略，使用默认值）
# 单次请求超时秒数；链路较慢或开启 include_raw_content 时可适当调大
TAVILY_TIMEOUT=30
# 传输层重试次数：处理连接池里已被对端关闭的 keep-alive 连接（间歇性 ConnectionReset 的主因）
TAVILY_TRANSPORT_RETRIES=3
# 应用层尝试次数：传输层重试耗尽后整体再试的次数
TAVILY_MAX_ATTEMPTS=2
# 退避基数：第 n 次重试等待 TAVILY_BACKOFF_BASE * 2^(n-1) 秒
TAVILY_BACKOFF_BASE=0.8
# 所在网络需要代理访问 Tavily 时才需要设置（不设则跟随系统 HTTP_PROXY / HTTPS_PROXY）
# TAVILY_HTTP_PROXY=http://127.0.0.1:7890
# TAVILY_HTTPS_PROXY=http://127.0.0.1:7890

# 自建 RAG embedding 配置（可选）
# 三项齐全时启用向量语义检索（与 BM25 双路融合）；任一缺失时自动降级为纯 BM25，系统仍可用
#
# 推荐：本地 TEI 服务（HuggingFace text-embeddings-inference + bge-large-zh-v1.5，1024 维）
#   docker compose --env-file .env -f docker/docker-compose.yaml up -d embedding
#   （模型文件需放在 docker/embedding/bge-large-zh-v1.5/）
# 备选：任意 OpenAI 兼容 /embeddings 端点（硅基流动、DashScope 等），改下面三行即可
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=local-tei
EMBEDDING_MODEL=bge-large-zh-v1.5
# embedding 服务对外端口，需与上面 BASE_URL 的端口一致
EMBEDDING_PORT=8081

# 向量库 Qdrant（可选，见 ADR-007）
# 存放 chunk 向量，与本地 BM25 组成双路检索；服务未启动时自动降级为纯 BM25
#   docker compose --env-file .env -f docker/docker-compose.yaml up -d qdrant
# dashboard: http://localhost:6333/dashboard
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=deepsearch_kb
# 对外端口，需与上面 QDRANT_URL 的端口一致
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 知识库摄入命令：python -m app.rag.ingest（加 --force 全量重建索引）
# 注意：bge-large-zh-v1.5 单条输入上限 512 token（约 512 个中文字），
#       切分参数 CHUNK_SIZE 已控制在 400 字符以内，不要随意调大

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# 反思循环配置（可省略，使用默认值）
# 最大迭代轮数：每轮 = 执行 → 反思评估 → 补充检索
REFLECTION_MAX_ROUNDS=3
# token 预算上限：累计消耗超过该值后停止迭代，输出当前最优结果
REFLECTION_TOKEN_BUDGET=150000
